{
  "name": "holoscopic",
  "description": "Games that help groups see what they collectively think",
  "private": true,
  "license": "MIT",
  "author": "Mark Othell",
  "repository": {
    "type": "git",
    "url": "https://github.com/markothell/holoscopic-app.git"
  },
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:spectrum": "npm run dev --workspace=apps/spectrum",
    "dev:game": "npm run dev --workspace=apps/holoscopic-game",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:platform": "npm run dev --workspace=apps/platform",
    "dev:unison": "npm run dev --workspace=apps/unison",
    "build": "turbo build",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
