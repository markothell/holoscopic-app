{
  "name": "holoscopic",
  "description": "Games that help groups see what they collectively think",
  "private": true,
  "license": "MIT",
  "author": "Mark Othell",
  "repository": {
    "type": "git",
    "url": "https://github.com/markothell/holoscopic-app.git"
  },
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:spectrum": "npm run dev --workspace=apps/spectrum",
    "dev:game": "npm run dev --workspace=apps/holoscopic-game",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:platform": "npm run dev --workspace=apps/platform",
    "dev:synthesis": "npm run dev --workspace=apps/synthesis",
    "dev:chorus": "npm run dev --workspace=apps/chorus",
    "dev:threshold": "npm run dev --workspace=apps/threshold",
    "dev:circles": "npm run dev --workspace=apps/circles",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:tunnel": "node apps/backend/scripts/dev-tunnel.js",
    "clean": "if lsof -ti TCP:4000-4007 -sTCP:LISTEN >/dev/null 2>&1; then echo '✗ dev servers are running on 4000-4007 — stop them first, or use clean:force'; exit 1; fi; npm run clean:force",
    "clean:force": "rm -rf apps/*/.next apps/*/.turbo .turbo && echo '✓ build caches cleared'"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
