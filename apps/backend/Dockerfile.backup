# Image for the daily mongodump cron service (render.yaml → holoscopic-mongo-backup).
#
# Exists only because Render's stock Node runtime has no mongodb-database-tools.
# scripts/backup-mongo.js refuses to run without mongodump rather than exiting
# zero on an empty backup, so this Dockerfile is what makes the job possible at
# all.
FROM node:22-bookworm-slim

# mongodb-database-tools provides mongodump/mongorestore. Pinned to the distro
# package so the image does not silently change tool versions between builds.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
    && curl -fsSL https://pgp.mongodb.com/server-7.0.asc \
        | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg] https://repo.mongodb.org/apt/debian bookworm/mongodb-org/7.0 main" \
        > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends mongodb-database-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only the backend workspace is needed; the frontends are irrelevant here.
COPY apps/backend/package.json apps/backend/package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

# scripts/backup-blobs.js reads the database to learn which recordings SHOULD
# exist, so the models and the mirror util travel with it. Without these the
# cron image builds fine and fails at 07:00 with a module-not-found.
COPY apps/backend/scripts ./scripts
COPY apps/backend/models ./models
COPY apps/backend/utils ./utils

# Fail the BUILD if mongodump is missing, so a broken image never reaches the
# schedule and starts silently "succeeding".
RUN mongodump --version

# Both backups, every night, independently reported.
#
# Run unconditionally rather than chained with && — a failing mongodump must
# not also skip the media copy and hide a second problem behind the first. The
# exit code is the worse of the two, so the cron's dead-man's-switch fires if
# EITHER half failed.
CMD ["sh", "-c", "node scripts/backup-mongo.js; m=$?; node scripts/backup-blobs.js; b=$?; [ $m -gt $b ] && exit $m || exit $b"]
